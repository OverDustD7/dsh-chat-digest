{
  "name": "dsh-chat-digest",
  "version": "1.5.1",
  "description": "Turn chat logs into a panel list maintained by a resident agent. Includes a zero npm-dependency core and an optional WeChat/QQ ingestion pipeline. Installs as a DSH profile bundle.",
  "type": "module",
  "main": "lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "pipeline",
    "agent",
    "prompt",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.zh.md",
    "CHANGELOG.md",
    "!agent/output",
    "!agent/inbox",
    "!agent/docs/knowledge",
    "!agent/docs/archive",
    "!**/__pycache__",
    "!**/*.pyc",
    "!local",
    "!profile"
  ],
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.5-rc.1"
  },
  "scripts": {
    "check": "node --check lib/plugin.js && node --check lib/client.js && node --check lib/ui.js && node --check lib/right.js",
    "check:body": "python tools/check_host_body.py",
    "test:host": "node test/host-behavior-checks.mjs",
    "test:portability": "node test/portability-checks.mjs",
    "test:ui": "node test/ui-client-checks.mjs",
    "test:pipeline": "python test/pipeline-behavior-checks.py",
    "prepack": "npm run check && npm run test:host && npm run test:portability && npm run test:ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OverDustD7/dsh-chat-digest.git"
  },
  "homepage": "https://github.com/OverDustD7/dsh-chat-digest#readme",
  "bugs": {
    "url": "https://github.com/OverDustD7/dsh-chat-digest/issues"
  },
  "author": "用户 (OverDustD7)",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis-plugin",
    "dsh-bundle",
    "wechat",
    "qq",
    "chat-logs",
    "digest",
    "panel",
    "agent-session",
    "automation"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1"
    }
  }
}
